# Copy to .env in this directory. Never commit keys.
SERPER_API_KEY=
JINA_API_KEY=
LLM_API_KEY=
# Set the endpoint paired with your LLM key; do not send an OpenAI key to a third party.
LLM_API_BASE_URL=
LLM_MODEL=
OUTPUT_DIR=./output
USE_PROXY=false
GENERATE_BATCH_SIZE=2
GENERATE_CONCURRENT_LIMIT=2
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=6000
LLM_TIMEOUT=180
LLM_RETRY_ATTEMPTS=2
YOUTUBE_INITIAL_SEARCH_RESULTS=5
YOUTUBE_MAX_RESULTS_AFTER_FILTER=3
YOUTUBE_EXTRACT_TOP_K=2
YOUTUBE_SEARCH_WORKERS=2
YOUTUBE_TRANSCRIPT_WORKERS=1
YOUTUBE_SEARCH_TIMEOUT=45
YOUTUBE_TRANSCRIPT_RETRIES=1
SEARCH_MAX_RETRIES=1
WEB_SEARCH_TOP_N=10
WEB_EXTRACT_TOP_K=3
WEB_SEARCH_CONCURRENCY=2
WEB_EXTRACT_RETRIES=1
JINA_RPM=15
JINA_CONCURRENCY=1
# Reddit and Discord remain valid sources for their own community pages.
# Block direct competitors, generic wiki mirrors, and low-value scrape domains.
BLOCKED_DOMAINS=wiki.gg,fandom.com,fextralife.com
